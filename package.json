{
  "name": "miras-beauty-touch",
  "version": "1.0.0",
  "description": "Full-Stack Web Platform for Mira's Beauty Touch - Salon & Perfume",
  "main": "server/src/index.js",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix server install && npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/src/index.js",
    "start:server": "node server/src/index.js",
    "start:php": "C:\\xampp\\php\\php.exe -S 0.0.0.0:5000 -t php-server/public",
    "seed:php": "C:\\xampp\\php\\php.exe php-server/bin/seed.php",
    "start:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "test": "node server/test-suite.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["beauty-salon", "perfume", "nigeria", "full-stack", "react", "express", "sqlite"],
  "author": "Mira's Beauty Touch",
  "license": "ISC"
}

