<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(www\.)?mirabeautytouch\.com [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Preserve HTTP Authorization Header for JWT Authentication
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

    # 3. Block direct browser access to sensitive files
    <FilesMatch "(\.env|\.db|\.sqlite|composer\.(json|lock))$">
        Require all denied
    </FilesMatch>

    # 4. Route API endpoints directly to PHP REST Backend
    RewriteRule ^api(/.*)?$ php-server/public/index.php [L,QSA]
    RewriteRule ^uploads(/.*)?$ php-server/public/index.php [L,QSA]

    # 5. Serve existing files directly (JS, CSS, images, MP4 videos)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. Check client/dist static assets if accessed directly
    RewriteCond %{DOCUMENT_ROOT}/client/dist/$1 -f
    RewriteRule ^(.*)$ client/dist/$1 [L]

    # 7. Single Page Application (SPA) client routing fallback
    RewriteCond %{DOCUMENT_ROOT}/client/dist/index.html -f
    RewriteRule ^ client/dist/index.html [L]

    RewriteRule ^ index.html [L]
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
